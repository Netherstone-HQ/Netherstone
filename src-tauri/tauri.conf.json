{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Netherstone",
  "version": "0.1.0-beta.1",
  "identifier": "tech.blueblood.netherstone",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Netherstone",
        "width": 1200,
        "height": 700,
        "minWidth": 400,
        "minHeight": 300,
        "decorations": false,
        "dragDropEnabled": false,
        "visible": false,
        "backgroundColor": "#141516"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM5Q0E0ODU0RkI2MTM1QzIKUldUQ05XSDdWRWpLeVJKTUxYNVdKRFF2SHI5NzlYMEx1dVlIemttQksxY0RwWENDR0psSkErQnIK"
    }
  }
}
