{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Netherstone",
  "version": "0.3.0-beta.1",
  "identifier": "tech.blueblood.netherstone",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Netherstone",
        "width": 1200,
        "height": 700,
        "minWidth": 400,
        "minHeight": 300,
        "decorations": false,
        "dragDropEnabled": false,
        "visible": false,
        "backgroundColor": "#141516"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval' 'sha256-UBe/P1k6jQKMGqi/8Nhi5IvRzF3HlPzOPe0io8R06Fs='",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost data: blob: https: http:",
        "media-src": "'self' asset: http://asset.localhost data: blob: https: http:",
        "font-src": "'self' data: https://esm.sh",
        "connect-src": "'self' ipc: http://ipc.localhost asset: http://asset.localhost data: blob: https://esm.sh https://libraries.excalidraw.com https://raw.githubusercontent.com",
        "worker-src": "'self' blob:",
        "frame-src": "'self' blob: https:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"],
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM5Q0E0ODU0RkI2MTM1QzIKUldUQ05XSDdWRWpLeVJKTUxYNVdKRFF2SHI5NzlYMEx1dVlIemttQksxY0RwWENDR0psSkErQnIK"
    }
  }
}
